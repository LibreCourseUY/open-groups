# Branding (all optional)
APP_NAME=Groups
APP_DESCRIPTION=Directorio de grupos
DISCLAIMER=

# Admin panel password
ADMIN_PASSWORD=admin123

# Secret used to sign admin tokens (required in production)
SECRET_KEY=

LOG_LEVEL=INFO

# HTTP port used by the container / uvicorn (default 8080)
PORT=8080

# Optional usage metrics (leave METRICS_API_KEY empty to disable)
METRICS_API_KEY=
# METRICS_EVENTS_URL=https://api.eclipselabs.com.uy/metrics/event
# METRICS_VIEWS_URL=https://api.eclipselabs.com.uy/metrics/views

ENVIRONMENT=DEV

# DEV (SQLite): plain or async URLs both work
DATABASE_URL=sqlite:///./groups.db
# PROD (PostgreSQL): DATABASE_URL=postgresql://user:pass@host:5432/groups
