# Branding (all optional)
APP_NAME=Groups
APP_DESCRIPTION=Directorio de grupos
DISCLAIMER=

# Admin panel password
ADMIN_PASSWORD=admin123

# Secret used to sign admin tokens (required in production)
SECRET_KEY=

LOG_LEVEL=INFO

# Optional usage metrics
METRICS_API_KEY=your_metrics_api_key_here

ENVIRONMENT=DEV
# PROD: DATABASE_URL=postgresql://user:pass@host:5432/groups
DATABASE_URL=sqlite:///./groups.db
